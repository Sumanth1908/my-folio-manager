# Copy to .env and adjust. All values also readable from real environment variables.

# development | production (production refuses to boot with the default SECRET_KEY)
ENVIRONMENT=development

DATABASE_URL=mysql+pymysql://finance_user:finance_password@127.0.0.1:3306/finance_db

# Redis: used for Celery, stock-price cache, rate limiting, and the automation lock.
# REDIS_URL falls back to CELERY_BROKER_URL when unset.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# REDIS_URL=redis://127.0.0.1:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

# Google Gemini API key for the AI assistant (optional)
GOOGLE_API_KEY=

# JSON list of allowed origins; ["*"] only for development
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
